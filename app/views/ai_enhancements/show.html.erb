<h2>AI enhancement — <%= link_to "##{@issue.id}", issue_path(@issue) %></h2>
<p>Mode: <%= @enhancement.mode %> · Status: <strong><%= @enhancement.state %></strong></p>
<% if %w[queued processing].include?(@enhancement.state) %>
  <% content_for :header_tags do %><meta http-equiv="refresh" content="5"><% end %>
  <p>The ticket is being enhanced. This page refreshes automatically.</p>
  <%= link_to 'Refresh', issue_ai_enhancement_path(@issue, @enhancement), class: 'icon icon-reload' %>
<% end %>
<% if @document['error'] %><div class="flash error"><%= @document['error'] %></div><% end %>
<% Array(@document['warnings']).each do |warning| %><div class="flash warning"><%= warning %></div><% end %>
<% if @document['result'] %>
  <h3>Proposed ticket details</h3>
  <% @document['result']['fields'].each do |field| %>
    <h4><%= field['name'].humanize %></h4>
    <table class="list"><thead><tr><th>Current</th><th>Enhanced</th></tr></thead><tbody><tr>
      <td><pre style="white-space:pre-wrap;overflow-wrap:anywhere"><%= @fields[field['name']] %></pre></td>
      <td><pre style="white-space:pre-wrap;overflow-wrap:anywhere"><%= field['value'] %></pre></td>
    </tr></tbody></table>
  <% end %>
  <% if @document['result']['questions'].any? %>
    <h3>Questions to improve accuracy</h3><ol>
    <% @document['result']['questions'].each do |question| %><li><%= question %></li><% end %>
    </ol>
  <% end %>
  <h3>Retrieved sources</h3>
  <ul><% @document['sources'].each do |source| %>
    <li>[<%= source['id'] %>] <%= source['reference'] %> — revision: <%= source['revision'] %>
      <%= '(cited)' if @document['result']['source_ids'].include?(source['id']) %></li>
  <% end %></ul>
  <% if @document['sources'].empty? %><p>No matching source evidence was found. Technical additions must remain limited to supplied ticket facts.</p><% end %>
<% end %>
<% if @enhancement.mode == 'interactive' && @enhancement.state == 'draft' %>
  <%= form_tag reply_issue_ai_enhancement_path(@issue, @enhancement) do %>
    <p><%= label_tag :reply, 'Answers, additional facts or instructions' %><br>
    <%= text_area_tag :reply, '', rows: 7, maxlength: 8000, required: true, style: 'width:95%' %></p>
    <%= submit_tag 'Revise with AI' %>
  <% end %>
  <br>
  <%= button_to 'Apply enhanced ticket', apply_issue_ai_enhancement_path(@issue, @enhancement), method: :post %>
<% end %>
<% if @document['messages'].any? %>
  <h3>Your supplied information</h3>
  <% @document['messages'].select { |message| message['role'] == 'user' }.each do |message| %>
    <pre style="white-space:pre-wrap"><%= message['text'] %></pre>
  <% end %>
<% end %>
<p><%= link_to 'Back to ticket', issue_path(@issue) %></p>
